---
const {article=null}=Astro.props;
---
<section class="research-workspace" data-research data-article-id={article?.id??''} data-article-title={article?.title??''} data-revision={article?.revision??''} data-pagefind-ignore>
{article?<h2>Ghi chú nghiên cứu</h2>:<p class="meta">Bàn nghiên cứu cá nhân. Ghi chú lưu trong IndexedDB của trình duyệt này, không gửi lên máy chủ. Đăng xuất không xóa dữ liệu cục bộ. Nên sao lưu định kỳ.</p>}
<noscript><p>Cần JavaScript để sử dụng bàn nghiên cứu.</p></noscript>
<div data-research-controls hidden>
<div class="research-actions"><button type="button" data-new-note>＋ Ghi chú mới</button>{article?<a href="/research/">Mở bàn nghiên cứu</a>:<><button type="button" data-export-notes>Xuất JSON</button><button type="button" data-import-notes>Nhập JSON</button><input type="file" data-import-file accept=".json,application/json" hidden/><button type="button" data-clear-notes>Xóa toàn bộ</button></>}</div>
{article&&<p class="meta">Bôi chọn đoạn văn trong bài rồi nhấn “Lưu trích đoạn”. Ghi chú không thay đổi bài viết gốc.</p>}
<div class="research-filter"><label>Tìm ghi chú<input type="search" data-note-query placeholder="Tiêu đề, nội dung, trích đoạn…"/></label><label>Thẻ<select data-note-tag><option value="">Tất cả</option></select></label></div>
<p data-note-count aria-live="polite"></p><div data-note-list></div><p data-research-message role="status"></p>
</div>
{article&&<button type="button" class="quote-capture" data-capture-quote hidden>Lưu trích đoạn</button>}
<dialog data-note-dialog aria-labelledby="note-editor-title"><form data-note-form><h2 id="note-editor-title">Ghi chú</h2><label>Tiêu đề<input name="title" required maxlength="300"/></label><label>Nội dung<textarea name="body" rows="6" maxlength="20000"></textarea></label><div data-note-source></div><label>Thẻ (phân cách bằng dấu phẩy)<input name="tags" maxlength="1220" placeholder="ý thức, bản thể học"/></label><label>Liên kết ghi chú<select data-link-picker><option value="">Chọn ghi chú</option></select></label><button type="button" data-add-link>Thêm liên kết</button><ul data-edit-links></ul><p data-editor-message role="status"></p><div class="research-actions"><button type="submit">Lưu ghi chú</button><button type="button" data-close-editor>Hủy</button></div></form></dialog>
</section>
<script>
import {listNotes,saveNote,deleteNote,importNotes,clearNotes,filterNotes,locateQuote,subscribe} from './research-store.mjs';
const root=document.querySelector('[data-research]');
if(root){
const q=s=>root.querySelector(s),controls=q('[data-research-controls]'),list=q('[data-note-list]'),message=q('[data-research-message]'),dialog=q('[data-note-dialog]'),form=q('[data-note-form]'),picker=q('[data-link-picker]'),tag=q('[data-note-tag]'),query=q('[data-note-query]'),capture=q('[data-capture-quote]');
const source=root.dataset.articleId?{id:root.dataset.articleId,title:root.dataset.articleTitle,revision:root.dataset.revision}:null,article=source?document.querySelector('main article'):null;
let notes=[],editing=null,expectedVersion=null,links=[],selection=null,sequence=0,saving=false;
const say=t=>message.textContent=t;
const el=(name,text,cls)=>{const n=document.createElement(name);if(text!==undefined)n.textContent=text;if(cls)n.className=cls;return n;};
const button=(text,fn)=>{const b=el('button',text);b.type='button';b.addEventListener('click',fn);return b;};
function rangeAt(start,length){if(!article)return null;const walker=document.createTreeWalker(article,NodeFilter.SHOW_TEXT);let offset=0,a,b,n;while((n=walker.nextNode())){const end=offset+n.length;if(!a&&start<end)a=[n,start-offset];if(a&&start+length<=end){b=[n,start+length-offset];break;}offset=end;}if(!a||!b)return null;const range=document.createRange();range.setStart(...a);range.setEnd(...b);return range;}
function anchor(n){return locateQuote(article?.textContent??'',n.quote,n.article?.revision===source?.revision);}
function highlight(){if(!article||!globalThis.CSS?.highlights||typeof Highlight==='undefined')return;const ranges=[];for(const n of notes.filter(n=>n.article?.id===source.id&&n.quote)){const a=anchor(n);if(a.start!==undefined){const r=rangeAt(a.start,n.quote.text.length);if(r)ranges.push(r);}}CSS.highlights.set('research-quotes',new Highlight(...ranges));}
function jump(n){const a=anchor(n);if(a.start===undefined){say('Không xác định được vị trí trích đoạn trong phiên bản này.');return;}const r=rangeAt(a.start,n.quote.text.length);if(!r)return;const parent=r.startContainer.parentElement;const panel=parent.closest('.wiki-section-content[hidden]');if(panel){document.querySelector('[aria-controls="'+panel.id+'"]')?.click();}parent.scrollIntoView({block:'center'});const s=getSelection();s.removeAllRanges();s.addRange(r);}
function render(){const selected=tag.value;tag.replaceChildren(new Option('Tất cả',''));for(const t of [...new Set(notes.filter(n=>!source||n.article?.id===source.id).flatMap(n=>n.tags))].sort((a,b)=>a.localeCompare(b,'vi')))tag.append(new Option(t,t));tag.value=[...tag.options].some(o=>o.value===selected)?selected:'';
 const rows=filterNotes(notes,query.value,tag.value,source?.id??'');q('[data-note-count]').textContent=rows.length+' ghi chú';list.replaceChildren();if(!rows.length)list.append(el('p','Chưa có ghi chú phù hợp.'));
 for(const n of rows){const card=el('section',undefined,'research-note');card.id='note-'+n.id;card.append(el('h3',n.title));if(n.article){const p=el('p',undefined,'subtitle'),a=el('a',n.article.title);a.href='/wiki/'+n.article.id+'/';p.append('Nguồn: ',a,' · '+n.article.revision.slice(0,12));card.append(p);}
 if(n.quote){card.append(el('blockquote',n.quote.text));if(article){const a=anchor(n);card.append(el('small',({exact:'Đúng vị trí đã lưu',relocated:'Tìm thấy lại trích đoạn',missing:'Trích đoạn không còn khớp',ambiguous:'Trích đoạn xuất hiện nhiều lần'})[a.state]??''));if(a.start!==undefined)card.append(button('Đến trích đoạn',()=>jump(n)));}}
 if(n.body)card.append(el('p',n.body,'research-note-body'));if(n.tags.length)card.append(el('p',n.tags.map(t=>'#'+t).join(' · '),'subtitle'));
 const refs=n.links.map(id=>({id,n:notes.find(x=>x.id===id)}));const back=notes.filter(x=>x.links.includes(n.id));
 for(const [label,items] of [['Liên kết',refs],['Liên kết ngược',back.map(n=>({id:n.id,n}))]])if(items.length){const p=el('p',label+': ');for(const [i,x] of items.entries()){if(i)p.append(' · ');if(x.n){const a=el('a',x.n.title);a.href='/research/#note-'+x.id;p.append(a);}else p.append('Ghi chú đã xóa hoặc chưa nhập');}card.append(p);}
 const actions=el('div',undefined,'research-actions');actions.append(button('Sửa',()=>openEditor(n)),button('Xóa',async()=>{if(confirm('Xóa ghi chú này?'))try{await deleteNote(n.id);say('Đã xóa ghi chú.');await refresh();}catch{say('Không xóa được ghi chú.');}}));card.append(actions);list.append(card);}
 highlight();}
async function refresh(){const n=++sequence;try{const data=await listNotes();if(n!==sequence)return;notes=data;render();}catch{say('Không mở được dữ liệu nghiên cứu cục bộ.');}}
function editLinks(){picker.replaceChildren(new Option('Chọn ghi chú',''));for(const n of notes)if(n.id!==editing.id&&!links.includes(n.id))picker.append(new Option(n.title,n.id));const ul=q('[data-edit-links]');ul.replaceChildren();for(const id of links){const li=el('li',notes.find(n=>n.id===id)?.title??'Ghi chú chưa có');li.append(' ',button('Bỏ liên kết',()=>{links=links.filter(x=>x!==id);editLinks();}));ul.append(li);}}
function openEditor(n=null,quote=null){if(dialog.open)return;const now=new Date().toISOString();editing=n?structuredClone(n):{id:globalThis.crypto.randomUUID(),title:'',body:'',tags:[],links:[],article:source,quote,created:now,updated:now};expectedVersion=n?n.updated:null;links=[...editing.links];form.elements.title.value=editing.title||(quote?'Trích đoạn: '+source.title:'');form.elements.body.value=editing.body;form.elements.tags.value=editing.tags.join(', ');const info=q('[data-note-source]');info.replaceChildren();if(editing.article)info.append(el('p','Nguồn: '+editing.article.title,'subtitle'));if(editing.quote)info.append(el('blockquote',editing.quote.text));q('[data-editor-message]').textContent='';editLinks();dialog.showModal();form.elements.title.focus();}
q('[data-new-note]').addEventListener('click',()=>openEditor());
q('[data-add-link]').addEventListener('click',()=>{if(picker.value&&links.length<100){links.push(picker.value);editLinks();}});
q('[data-close-editor]').addEventListener('click',()=>{if(!saving)dialog.close();});
dialog.addEventListener('cancel',e=>{if(saving)e.preventDefault();});
form.addEventListener('submit',async e=>{e.preventDefault();if(saving)return;saving=true;const submit=form.querySelector('[type=submit]');submit.disabled=true;try{const expected=expectedVersion;const v={...editing,title:form.elements.title.value,body:form.elements.body.value,tags:form.elements.tags.value.split(',').map(s=>s.trim()).filter(Boolean),links,updated:new Date(Math.max(Date.now(),Date.parse(editing.updated)+1)).toISOString()};await saveNote(v,expected);dialog.close();say('Đã lưu ghi chú.');await refresh();}catch{q('[data-editor-message]').textContent='Không lưu được. Kiểm tra giới hạn dữ liệu hoặc ghi chú đã thay đổi ở tab khác.';}finally{saving=false;submit.disabled=false;}});
query.addEventListener('input',render);tag.addEventListener('change',render);
if(capture&&article){document.addEventListener('selectionchange',()=>{const s=getSelection();if(!s?.rangeCount||s.isCollapsed){capture.hidden=true;return;}const r=s.getRangeAt(0);if(!article.contains(r.startContainer)||!article.contains(r.endContainer)){capture.hidden=true;return;}const prefix=document.createRange();prefix.selectNodeContents(article);prefix.setEnd(r.startContainer,r.startOffset);const start=prefix.toString().length,text=r.toString();if(!text.trim()||text.length>4000||article.textContent.slice(start,start+text.length)!==text){capture.hidden=true;return;}selection={text,start};capture.hidden=false;});capture.addEventListener('pointerdown',e=>e.preventDefault());capture.addEventListener('click',()=>{if(selection){const quote=selection;getSelection()?.removeAllRanges();capture.hidden=true;openEditor(null,quote);}});}
const file=q('[data-import-file]');if(file){q('[data-export-notes]').addEventListener('click',async()=>{try{const blob=new Blob([JSON.stringify({version:1,notes:await listNotes()},null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=el('a');a.href=url;a.download='philosophia-research.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);say('Đã xuất bản sao lưu.');}catch{say('Không xuất được ghi chú.');}});q('[data-import-notes]').addEventListener('click',()=>file.click());file.addEventListener('change',async()=>{try{const f=file.files?.[0];if(!f)return;if(f.size>50*1024*1024)throw Error();const data=JSON.parse(await f.text());if(confirm('Hợp nhất ghi chú từ bản sao lưu?')){await importNotes(data);say('Đã nhập ghi chú.');await refresh();}}catch{say('Tệp không hợp lệ, quá lớn hoặc vượt giới hạn ghi chú.');}finally{file.value='';}});q('[data-clear-notes]').addEventListener('click',async()=>{if(confirm('Xóa toàn bộ ghi chú nghiên cứu trên thiết bị này?'))try{await clearNotes();await refresh();say('Đã xóa toàn bộ.');}catch{say('Không xóa được dữ liệu.');}});}
subscribe(refresh);window.addEventListener('pageshow',refresh);controls.hidden=false;refresh().then(()=>{if(!source&&location.hash.startsWith('#note-'))document.getElementById(location.hash.slice(1))?.scrollIntoView();});
}
</script>
