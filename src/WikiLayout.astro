---
import './wiki.css';
const {title,description='',toc=[],article=false}=Astro.props;
---
<!doctype html>
<html lang="vi">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{title} | Philosophia</title>
<script is:inline>try{for(const [k,allowed] of Object.entries({theme:['dark','light'],font:['small','normal','large'],width:['normal','wide']})){const v=localStorage.getItem('philosophia-'+k);if(allowed.includes(v))document.documentElement.dataset[k]=v;}}catch{}</script></head>
<body class:list={[{'article-page':article}]} id="page-top">
<a class="skip" href="#main">Đến nội dung</a>
<header class="site-header">
<details class="wiki-menu"><summary aria-label="Menu chính" title="Menu chính">☰</summary><nav aria-label="Menu chính"><a href="/">Trang chính</a><a href="/wiki/">Tất cả bài viết</a><a href="/category/">Thể loại</a><a href="/special/random/">Bài viết ngẫu nhiên</a><a href="/special/">Trang đặc biệt</a><a href="https://github.com/PhilosophiaAtlas">Về dự án</a></nav></details>
<a class="brand" href="/">Philosophia</a>
<form class="header-search" action="/search/" role="search"><label class="sr-only" for="header-query">Tìm kiếm bài viết</label><input id="header-query" type="search" name="q" placeholder="Tìm kiếm Philosophia" autocomplete="off" required/><button type="submit">Tìm</button><div id="search-suggestions" class="search-suggestions" hidden><ul id="suggestion-list" aria-label="Gợi ý bài viết"></ul><a id="suggestion-all" href="/search/">Tất cả kết quả →</a><span id="suggestion-status" class="sr-only" role="status"></span></div></form>
<nav aria-label="Điều hướng"><a href="/wiki/">Bài viết</a><a href="/category/">Thể loại</a><a href="/special/">Trang đặc biệt</a></nav>
<details class="appearance"><summary aria-label="Giao diện và cách đọc" title="Giao diện và cách đọc">Aa</summary><div class="appearance-panel"><strong>Giao diện</strong><fieldset><legend>Màu sắc</legend><label><input type="radio" name="wiki-theme" value="auto"/> Tự động</label><label><input type="radio" name="wiki-theme" value="light"/> Sáng</label><label><input type="radio" name="wiki-theme" value="dark"/> Tối</label></fieldset><fieldset><legend>Cỡ chữ</legend><label><input type="radio" name="wiki-font" value="small"/> Nhỏ</label><label><input type="radio" name="wiki-font" value="normal"/> Tiêu chuẩn</label><label><input type="radio" name="wiki-font" value="large"/> Lớn</label></fieldset><fieldset><legend>Chiều rộng</legend><label><input type="radio" name="wiki-width" value="normal"/> Tiêu chuẩn</label><label><input type="radio" name="wiki-width" value="wide"/> Rộng</label></fieldset><label><input type="checkbox" id="preview-toggle"/> Xem trước liên kết bài viết khi nhấn</label></div></details>
</header>
<div class:list={['shell',{'no-toc':!toc.length}]}>{toc.length>0&&<aside aria-label="Mục lục"><details id="wiki-toc"><summary>Nội dung</summary><ul><li><a href="#page-top">Đầu bài</a></li>{toc.map((x)=><li class={'level-'+x.level}><a href={'#'+x.id}>{x.title}</a></li>)}</ul></details></aside>}<main id="main"><slot/></main></div>
<footer>PhilosophiaAtlas · Bách khoa thư triết học cá nhân · <a href="https://github.com/PhilosophiaAtlas">Mã nguồn</a></footer>
<dialog id="reference-preview" aria-labelledby="reference-title"><form method="dialog"><button class="dialog-close" aria-label="Đóng chú thích" autofocus>×</button></form><h2 id="reference-title">Chú thích</h2><p id="reference-content"></p><div class="preview-actions"><button id="reference-dismiss" type="button">Tiếp tục đọc</button><button id="reference-jump" type="button">Đến chú thích</button></div></dialog>
{article&&<a id="back-to-top" class="back-to-top" href="#page-top" aria-label="Về đầu trang" title="Về đầu trang" hidden>↑</a>}
<dialog id="wiki-preview" aria-labelledby="preview-title"><form method="dialog"><button class="dialog-close" aria-label="Đóng" autofocus>×</button></form><h2 id="preview-title">Xem trước bài viết</h2><p id="preview-summary" role="status"></p><div class="preview-actions"><button id="preview-dismiss" type="button">Tiếp tục đọc</button><button id="preview-open" type="button">Đọc bài đầy đủ →</button></div></dialog>
<script is:inline>
const root=document.documentElement;
const read=(key,fallback)=>{try{return localStorage.getItem('philosophia-'+key)??fallback}catch{return fallback}};
const write=(key,v)=>{try{localStorage.setItem('philosophia-'+key,v)}catch{}};
for(const [key,def] of Object.entries({theme:'auto',font:'normal',width:'normal'})){for(const el of document.querySelectorAll('input[name="wiki-'+key+'"]')){el.checked=el.value===read(key,def);el.addEventListener('change',()=>{if(!el.checked)return;if(key==='theme'&&el.value==='auto')delete root.dataset.theme;else root.dataset[key]=el.value;write(key,el.value);});}}
const toc=document.getElementById('wiki-toc');if(toc&&matchMedia('(min-width: 701px)').matches)toc.open=true;
const toggle=document.getElementById('preview-toggle');toggle.checked=read('preview','on')!=='off';toggle.addEventListener('change',()=>write('preview',toggle.checked?'on':'off'));
const dialog=document.getElementById('wiki-preview');
const previewTitle=document.getElementById('preview-title'),summary=document.getElementById('preview-summary'),openButton=document.getElementById('preview-open');
let sequence=0,request=null,destination=null,openedAt=0,opener=null,backdropDown=false;
function resetPreview(){sequence++;request?.abort();request=null;destination=null;backdropDown=false;}
function dismiss(){resetPreview();if(dialog.open)dialog.close();}
function outside(e){const r=dialog.getBoundingClientRect();return e.target===dialog&&(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom);}
document.addEventListener('click',e=>{
  const a=e.target.closest?.('main a[href]');
  if(!toggle.checked||!a||e.defaultPrevented||e.button!==0||e.ctrlKey||e.metaKey||e.shiftKey||e.altKey||a.target||a.hasAttribute('download')||typeof dialog.showModal!=='function')return;
  const url=new URL(a.href,location.href),match=url.pathname.match(/^\/wiki\/([a-z0-9-]+)\/?$/);
  if(url.origin!==location.origin||!match||url.hash||url.pathname.replace(/\/$/,'')===location.pathname.replace(/\/$/,''))return;
  e.preventDefault();
  resetPreview();const id=sequence;opener=a;destination=url.href;openedAt=performance.now();previewTitle.textContent=a.textContent;summary.textContent='Đang tải…';
  if(!dialog.open)dialog.showModal();
  const controller=new AbortController();request=controller;
  fetch('/preview/'+match[1]+'.json',{signal:controller.signal}).then(response=>{if(!response.ok)throw Error('Preview unavailable');return response.json();}).then(data=>{if(id!==sequence||!dialog.open)return;previewTitle.textContent=data.title;summary.textContent=data.summary||'Chưa có tóm tắt.';}).catch(error=>{if(error.name!=='AbortError'&&id===sequence&&dialog.open)summary.textContent='Không tải được phần xem trước. Anh có thể mở bài trực tiếp.';});
},{capture:true});
openButton.addEventListener('click',e=>{
  if(!dialog.open||!destination)return;
  // Prevent a quick second tap on the original link from activating the newly displayed button.
  if(e.detail>0&&performance.now()-openedAt<450)return;
  const next=destination;dismiss();location.assign(next);
});
document.getElementById('preview-dismiss').addEventListener('click',dismiss);
dialog.addEventListener('cancel',e=>{e.preventDefault();dismiss();});
dialog.addEventListener('close',()=>{if(dialog.open)return;resetPreview();if(opener?.isConnected)opener.focus({preventScroll:true});});
dialog.addEventListener('pointerdown',e=>{backdropDown=outside(e);});
dialog.addEventListener('click',e=>{if(backdropDown&&outside(e))dismiss();backdropDown=false;});
window.addEventListener('pagehide',dismiss);
window.addEventListener('pageshow',()=>{dismiss();toggle.checked=read('preview','on')!=='off';});
document.addEventListener('click',e=>{for(const item of document.querySelectorAll('.wiki-menu[open],.appearance[open]'))if(!item.contains(e.target))item.open=false;});
document.addEventListener('keydown',e=>{if(e.key==='Escape')for(const item of document.querySelectorAll('.wiki-menu[open],.appearance[open]')){item.open=false;item.querySelector('summary')?.focus();}});
</script>
<script is:inline>
(()=>{
const input=document.getElementById('header-query'),form=input.form,box=document.getElementById('search-suggestions'),list=document.getElementById('suggestion-list'),all=document.getElementById('suggestion-all'),status=document.getElementById('suggestion-status');
const norm=s=>s.normalize('NFD').replace(/\p{M}/gu,'').toLowerCase().replace(/đ/g,'d').trim();
let indexPromise,seq=0,timer,active=-1,options=[];
function hide(){seq++;clearTimeout(timer);box.hidden=true;input.setAttribute('aria-expanded','false');active=-1;input.removeAttribute('aria-activedescendant');}
input.setAttribute('role','combobox');input.setAttribute('aria-autocomplete','list');input.setAttribute('aria-controls','suggestion-list');input.setAttribute('aria-expanded','false');list.setAttribute('role','listbox');
function distance(a,b){let prev=Array.from({length:b.length+1},(_,i)=>i);for(let i=1;i<=a.length;i++){let next=[i];for(let j=1;j<=b.length;j++)next[j]=Math.min(next[j-1]+1,prev[j]+1,prev[j-1]+Number(a[i-1]!==b[j-1]));prev=next;}return prev[b.length];}
function score(row,q){let best=Infinity;for(const v of row.keys){if(v===q)best=Math.min(best,0);else if(v.startsWith(q))best=Math.min(best,1);else if(v.includes(q))best=Math.min(best,3);else if(q.length>=4&&q.length<=40&&v.length<=50){const d=distance(q,v);if(d<= (q.length>=8?2:1))best=Math.min(best,5+d);}}return best;}
async function show(){const id=++seq,q=norm(input.value);if(!q||q.length>100){hide();return;}all.href='/search/?q='+encodeURIComponent(input.value.trim());try{indexPromise??=fetch('/search-index.json').then(r=>{if(!r.ok)throw Error();return r.json()}).then(rows=>rows.map(row=>({...row,keys:[row.title,row.originalTitle??'',row.id,...row.aliases].map(norm)})));const rows=await indexPromise;if(id!==seq)return;options=rows.map(row=>({row,rank:score(row,q)})).filter(x=>Number.isFinite(x.rank)).sort((a,b)=>a.rank-b.rank||a.row.title.localeCompare(b.row.title,'vi')).slice(0,7).map(x=>x.row);list.replaceChildren();active=-1;input.removeAttribute('aria-activedescendant');for(const [i,row] of options.entries()){const li=document.createElement('li'),a=document.createElement('a'),name=document.createElement('strong'),sub=document.createElement('small');li.setAttribute('role','option');li.id='suggestion-'+i;li.setAttribute('aria-selected','false');a.href='/wiki/'+row.id+'/';a.tabIndex=-1;name.textContent=row.title;sub.textContent=row.originalTitle??'';a.append(name,sub);li.append(a);list.append(li);}status.textContent=options.length+' gợi ý';box.hidden=false;input.setAttribute('aria-expanded','true');}catch{if(id===seq){indexPromise=undefined;list.replaceChildren();options=[];status.textContent='Không tải được gợi ý';box.hidden=false;input.setAttribute('aria-expanded','true');}}}
function select(i){active=i;for(const [j,li] of [...list.children].entries())li.setAttribute('aria-selected',String(i===j));if(i>=0)input.setAttribute('aria-activedescendant','suggestion-'+i);else input.removeAttribute('aria-activedescendant');}
input.addEventListener('input',()=>{hide();timer=setTimeout(show,120);});
input.addEventListener('focus',()=>{if(input.value.trim())show()});
input.addEventListener('keydown',e=>{if(e.key==='Escape'){hide();return;}if(box.hidden||!options.length)return;if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();select(e.key==='ArrowDown'?(active+1)%options.length:(active<=0?options.length-1:active-1));}else if(e.key==='Enter'&&active>=0){e.preventDefault();location.assign('/wiki/'+options[active].id+'/');}});
form.addEventListener('submit',()=>hide());document.addEventListener('click',e=>{if(!form.contains(e.target))hide();});form.addEventListener('focusout',e=>{if(e.relatedTarget&&!form.contains(e.relatedTarget))hide();});window.addEventListener('pagehide',hide);
})();
(()=>{
const dialog=document.getElementById('reference-preview'),title=document.getElementById('reference-title'),content=document.getElementById('reference-content');let target=null,opener=null;
document.addEventListener('click',e=>{const a=e.target.closest?.('article .citation a[href^="#ref-"]');if(!a||e.defaultPrevented||e.button!==0||e.ctrlKey||e.metaKey||e.shiftKey||e.altKey||typeof dialog.showModal!=='function')return;const node=document.getElementById(a.hash.slice(1));if(!node)return;e.preventDefault();target=node;opener=a;title.textContent='Chú thích '+a.textContent.replace(/[^0-9]/g,'');content.replaceChildren();const source=node.querySelector('.reference-text');if(source)content.append(source.cloneNode(true));dialog.showModal();});
document.getElementById('reference-dismiss').addEventListener('click',()=>dialog.close());
document.getElementById('reference-jump').addEventListener('click',()=>{if(!target)return;const id=target.id;dialog.close();if(location.hash==='#'+id)window.dispatchEvent(new HashChangeEvent('hashchange'));else location.hash=id;});
dialog.addEventListener('close',()=>{if(opener?.isConnected)opener.focus({preventScroll:true});target=null;opener=null;});
})();
</script>
{article&&<script is:inline>
(()=>{
 const article=document.querySelector('main article'),root=document.documentElement,focus=document.getElementById('reading-focus'),collapseAll=document.getElementById('sections-toggle'),top=document.getElementById('back-to-top'),meter=document.getElementById('reading-progress');
 if(!article||!focus||!collapseAll||!top||!meter)return;
 const get=(k,d)=>{try{return localStorage.getItem('philosophia-'+k)??d}catch{return d}};
 const put=(k,v)=>{try{localStorage.setItem('philosophia-'+k,v)}catch{}};
 const sections=[];
 // Keep original headings and IDs; collapse only the content of each top-level section.
 const headings=[...article.children].filter(n=>n.tagName==='H2');
 for(const [i,h] of headings.entries()){
   const panel=document.createElement('div');panel.id='wiki-section-content-'+(i+1);panel.className='wiki-section-content';
   let n=h.nextSibling;while(n&&!(n.nodeType===1&&/^H[12]$/.test(n.tagName))){const next=n.nextSibling;panel.append(n);n=next;}
   h.after(panel);const button=document.createElement('button');button.type='button';button.className='section-toggle';button.setAttribute('aria-controls',panel.id);
   const label=h.textContent;button.setAttribute('aria-label','Thu gọn: '+label);button.setAttribute('aria-expanded','true');button.textContent='⌄';h.prepend(button);
   const item={h,panel,button,label};sections.push(item);
   button.addEventListener('click',()=>{setOpen(item,panel.hidden);refreshAll();schedule();});
 }
 function setOpen(item,open){item.panel.hidden=!open;item.button.setAttribute('aria-expanded',String(open));item.button.setAttribute('aria-label',(open?'Thu gọn: ':'Mở rộng: ')+item.label);item.button.textContent=open?'⌄':'›';}
 function refreshAll(){collapseAll.hidden=!sections.length;collapseAll.textContent=sections.every(x=>x.panel.hidden)?'Mở rộng tất cả':'Thu gọn tất cả';}
 collapseAll.addEventListener('click',()=>{const open=sections.every(x=>x.panel.hidden);for(const item of sections)setOpen(item,open);refreshAll();schedule();});
 function setFocus(on){root.dataset.readingFocus=on?'on':'off';focus.setAttribute('aria-pressed',String(on));focus.textContent=on?'Thoát chế độ tập trung':'Đọc tập trung';schedule();}
 focus.hidden=false;focus.addEventListener('click',()=>{const on=focus.getAttribute('aria-pressed')!=='true';setFocus(on);put('reading-focus',on?'on':'off');});
 const links=[...document.querySelectorAll('#wiki-toc a[href^="#"]')];
 const targets=links.map(a=>({a,node:document.getElementById(a.hash.slice(1))})).filter(x=>x.node);
 function revealHash(){let id;try{id=decodeURIComponent(location.hash.slice(1))}catch{return}const target=document.getElementById(id);if(!target)return;for(const item of sections)if(item.panel.contains(target)&&item.panel.hidden)setOpen(item,true);refreshAll();if(id)requestAnimationFrame(()=>target.scrollIntoView({block:'start'}));schedule();}
 for(const a of links)a.addEventListener('click',()=>{const target=document.getElementById(a.hash.slice(1));for(const item of sections)if(item.panel.contains(target))setOpen(item,true);refreshAll();if(matchMedia('(max-width:700px)').matches)document.getElementById('wiki-toc').open=false;schedule();});
 let pending=false;
 function update(){pending=false;const y=window.scrollY,max=Math.max(0,document.documentElement.scrollHeight-innerHeight);meter.value=max?Math.min(100,100*y/max):100;top.hidden=y<300;let current=targets[0];for(const x of targets){if(x.node.getClientRects().length&&x.node.getBoundingClientRect().top<=100)current=x;}for(const x of targets){if(x===current)x.a.setAttribute('aria-current','location');else x.a.removeAttribute('aria-current');}}
 function schedule(){if(!pending){pending=true;requestAnimationFrame(update);}}
 addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule);addEventListener('hashchange',revealHash);
 top.addEventListener('click',e=>{e.preventDefault();window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});if(location.hash)history.replaceState(null,'',location.pathname+location.search);});
 meter.hidden=false;refreshAll();setFocus(get('reading-focus','off')==='on');if(location.hash)revealHash();schedule();
})();
</script>}
</body></html>
