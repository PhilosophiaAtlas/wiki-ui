<dialog id="media-viewer" aria-labelledby="media-viewer-title"><div class="media-bar"><h2 id="media-viewer-title">Hình ảnh</h2><form method="dialog"><button aria-label="Đóng hình ảnh" autofocus>×</button></form></div><div id="media-stage"><img id="media-full" alt=""/></div><p id="media-caption"></p><div class="media-bar"><button type="button" id="media-prev">← Trước</button><span id="media-count" aria-live="polite"></span><button type="button" id="media-next">Sau →</button><button type="button" id="media-zoom" aria-pressed="false">Phóng to</button><a id="media-original" target="_blank" rel="noopener noreferrer">Mở ảnh gốc</a></div></dialog>
<script>
const dialog=document.getElementById('media-viewer'),full=document.getElementById('media-full'),stage=document.getElementById('media-stage'),caption=document.getElementById('media-caption'),count=document.getElementById('media-count'),prev=document.getElementById('media-prev'),next=document.getElementById('media-next'),zoom=document.getElementById('media-zoom'),original=document.getElementById('media-original');
let index=0,opener=null,images=[];
function collect(){return [...document.querySelectorAll('article img')].filter(img=>{try{const u=new URL(img.currentSrc||img.src,location.href);return u.origin===location.origin&&u.pathname.startsWith('/media/');}catch{return false;}});}
function resetZoom(){stage.classList.remove('zoomed');zoom.setAttribute('aria-pressed','false');zoom.textContent='Phóng to';stage.scrollTop=stage.scrollLeft=0;}
function show(i){index=(i+images.length)%images.length;const img=images[index];resetZoom();full.src=img.currentSrc||img.src;full.alt=img.alt;caption.textContent=img.title||img.alt||'Không có chú thích';count.textContent=(index+1)+' / '+images.length;original.href=full.src;prev.disabled=next.disabled=images.length<2;}
function enhance(){for(const img of collect()){if(img.closest('a,button')||img.dataset.mediaReady)continue;img.dataset.mediaReady='true';img.tabIndex=0;img.setAttribute('role','button');img.setAttribute('aria-label','Mở hình ảnh: '+(img.alt||'Hình minh họa'));img.classList.add('media-thumbnail');}}
function open(img){images=collect();const i=images.indexOf(img);if(i<0||typeof dialog.showModal!=='function')return;opener=img;show(i);if(!dialog.open)dialog.showModal();}
document.addEventListener('click',e=>{const img=e.target.closest?.('article img');if(img&&!img.closest('a,button')&&collect().includes(img)){e.preventDefault();open(img);}});
document.addEventListener('keydown',e=>{const img=e.target.closest?.('article img');if(img&&['Enter',' '].includes(e.key)&&!img.closest('a,button')){e.preventDefault();open(img);}});
prev.addEventListener('click',()=>show(index-1));next.addEventListener('click',()=>show(index+1));zoom.addEventListener('click',()=>{const on=stage.classList.toggle('zoomed');zoom.setAttribute('aria-pressed',String(on));zoom.textContent=on?'Thu nhỏ':'Phóng to';if(!on)resetZoom();});
dialog.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();show(index+(e.key==='ArrowLeft'?-1:1));}});
dialog.addEventListener('close',()=>{full.removeAttribute('src');resetZoom();opener?.focus({preventScroll:true});});window.addEventListener('pagehide',()=>{if(dialog.open)dialog.close();});enhance();
</script>
