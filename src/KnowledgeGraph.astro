<section id="knowledge-graph" data-pagefind-ignore>
<noscript><p>Đồ thị tương tác cần JavaScript. Anh vẫn có thể duyệt <a href="/wiki/">bài viết</a> và <a href="/category/">thể loại</a>.</p></noscript>
<div id="graph-controls" hidden>
<p class="meta">Mỗi nút là một mục từ, thể loại hoặc ghi chú. Các đường nối biểu thị quan hệ đã được ghi nhận, không phải mức độ đúng sai hay sự tương đồng về tư tưởng. Ghi chú chỉ được ghép vào đồ thị trên thiết bị này.</p>
<div class="graph-search"><label for="graph-query">Tìm nút</label><input id="graph-query" type="search" placeholder="Tên bài viết, thể loại, ghi chú…"/><select id="graph-results" size="4" aria-label="Kết quả tìm nút"></select><button id="graph-select" type="button">Khám phá nút</button></div>
<div class="graph-options"><fieldset><legend>Loại nút</legend><label><input type="checkbox" data-kind="article" checked/> Bài viết</label><label><input type="checkbox" data-kind="category" checked/> Thể loại</label><label><input type="checkbox" data-kind="note" checked/> Ghi chú</label></fieldset><fieldset><legend>Quan hệ</legend><label><input type="checkbox" data-edge="link" checked/> Liên kết bài</label><label><input type="checkbox" data-edge="membership" checked/> Thuộc thể loại</label><label><input type="checkbox" data-edge="parent" checked/> Thể loại cha</label><label><input type="checkbox" data-edge="source" checked/> Nguồn ghi chú</label><label><input type="checkbox" data-edge="note-link" checked/> Liên kết ghi chú</label></fieldset><label>Phạm vi<select id="graph-depth"><option value="1">1 bước</option><option value="2">2 bước</option><option value="3">3 bước</option></select></label></div>
<div class="graph-toolbar"><button id="graph-back" type="button">← Nút trước</button><button id="graph-overview" type="button">Tổng quan</button><button id="graph-zoom-in" type="button" aria-label="Phóng to đồ thị">＋</button><button id="graph-zoom-out" type="button" aria-label="Thu nhỏ đồ thị">−</button><button id="graph-fit" type="button">Vừa khung</button></div>
<p id="graph-status" role="status"></p>
<div class="graph-legend"><span class="graph-key article">Bài viết</span><span class="graph-key category">Thể loại</span><span class="graph-key note">Ghi chú</span></div>
<svg id="graph-svg" viewBox="-400 -280 800 560" role="group" aria-label="Đồ thị tri thức; kéo nền để di chuyển"><defs><marker id="graph-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0L10 5L0 10Z" fill="currentColor"/></marker></defs><g id="graph-world"></g></svg>
<section id="graph-detail" aria-label="Chi tiết nút"><h2 id="graph-title">Tổng quan</h2><p id="graph-node-meta"></p><a id="graph-open" hidden>Mở mục từ</a><h3>Nút lân cận</h3><ul id="graph-neighbors"></ul></section>
<details><summary>Danh sách nút đang hiển thị (thay thế đồ thị)</summary><ul id="graph-list"></ul></details>
</div></section>
<script>
import {assembleGraph,indexGraph,searchGraph,neighborhood,layoutGraph} from './graph-model.mjs';
import {listNotes,subscribe} from './research-store.mjs';
const root=document.getElementById('knowledge-graph');
if(root){
 const q=s=>root.querySelector(s),svg=q('#graph-svg'),world=q('#graph-world'),status=q('#graph-status'),query=q('#graph-query'),results=q('#graph-results'),NS='http://www.w3.org/2000/svg';
 let base,graph,focus='',trail=[],view,positions,camera={x:0,y:0,w:800,h:560},drag=null,ignoreClick=false,seq=0,noteWarning='';
 const typeLabels={article:'Bài viết',category:'Thể loại',note:'Ghi chú'},edgeLabels={link:'Liên kết bài',membership:'Thuộc thể loại',parent:'Thể loại cha',source:'Nguồn ghi chú','note-link':'Liên kết ghi chú'};
 const selected=attr=>[...root.querySelectorAll('input['+attr+']:checked')].map(n=>n.getAttribute(attr));
 const element=(tag,attrs={})=>{const e=document.createElementNS(NS,tag);for(const [k,v] of Object.entries(attrs))e.setAttribute(k,String(v));return e;};
 const button=(text,fn)=>{const b=document.createElement('button');b.type='button';b.textContent=text;b.addEventListener('click',fn);return b;};
 function cameraDraw(){svg.setAttribute('viewBox',[camera.x-camera.w/2,camera.y-camera.h/2,camera.w,camera.h].join(' '));}
 function fit(){const ps=[...positions.values()];if(!ps.length){camera={x:0,y:0,w:800,h:560};cameraDraw();return;}const xs=ps.map(p=>p.x),ys=ps.map(p=>p.y),left=Math.min(...xs)-125,right=Math.max(...xs)+125,top=Math.min(...ys)-80,bottom=Math.max(...ys)+80;camera={x:(left+right)/2,y:(top+bottom)/2,w:Math.max(360,right-left),h:Math.max(250,bottom-top)};cameraDraw();}
 function zoom(f){camera.w=Math.max(90,Math.min(18000,camera.w*f));camera.h=Math.max(60,Math.min(18000,camera.h*f));cameraDraw();}
 function refreshSearch(){const v=results.value;results.replaceChildren();for(const n of searchGraph(graph,query.value,selected('data-kind')))results.append(new Option(n.title+' · '+typeLabels[n.kind],n.id));if([...results.options].some(o=>o.value===v))results.value=v;else if(results.options.length)results.selectedIndex=0;q('#graph-select').disabled=!results.options.length;}
 function choose(id,push=true){if(id&&!graph.nodes.some(n=>n.id===id))return;if(id===focus)return;if(push)trail.push(focus);if(trail.length>100)trail.shift();focus=id;render();}
 function render(){const types=selected('data-kind'),edgeTypes=selected('data-edge'),idx=indexGraph(graph);if(focus&&!types.includes(idx.nodes.get(focus)?.kind))focus='';view=neighborhood(graph,focus,{depth:Number(q('#graph-depth').value),types,edgeTypes});positions=layoutGraph(view,focus);world.replaceChildren();
 for(const e of view.edges){const a=positions.get(e.from),b=positions.get(e.to),d=Math.hypot(b.x-a.x,b.y-a.y)||1;const line=element('line',{x1:a.x,y1:a.y,x2:b.x-(b.x-a.x)*17/d,y2:b.y-(b.y-a.y)*17/d,class:'graph-edge edge-'+e.kind,'marker-end':'url(#graph-arrow)'});const title=element('title');title.textContent=edgeLabels[e.kind];line.append(title);world.append(line);}
 for(const n of view.nodes){const p=positions.get(n.id),group=element('g',{transform:'translate('+p.x+' '+p.y+')',class:'graph-node '+n.kind+(n.id===focus?' active':''),tabindex:'0',role:'button','aria-label':n.title+' · '+typeLabels[n.kind],'data-node':n.id});const shape=n.kind==='category'?element('rect',{x:-13,y:-13,width:26,height:26,rx:4}):n.kind==='note'?element('path',{d:'M0 -17 L17 0 L0 17 L-17 0 Z'}):element('circle',{r:15});const label=element('text',{y:32,'text-anchor':'middle'});label.textContent=n.title.length>24?n.title.slice(0,23)+'…':n.title;const title=element('title');title.textContent=n.title;group.append(shape,label,title);group.addEventListener('click',()=>{if(!ignoreClick)choose(n.id);});group.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();choose(n.id);}});world.append(group);}
 status.textContent=view.nodes.length+' / '+graph.nodes.length+' nút · '+view.edges.length+' / '+graph.edges.length+' quan hệ'+(view.truncated?' · Đã giới hạn số nút hiển thị.':'')+(noteWarning?' · '+noteWarning:'');
 const node=idx.nodes.get(focus);q('#graph-title').textContent=node?.title??'Tổng quan';const open=q('#graph-open');open.hidden=!node;if(node){open.href=node.href;open.textContent='Mở '+typeLabels[node.kind].toLocaleLowerCase('vi');}else open.removeAttribute('href');
 const near=q('#graph-neighbors');near.replaceChildren();const neighbors=(idx.adj.get(focus)??[]).filter(x=>types.includes(idx.nodes.get(x.id)?.kind)&&edgeTypes.includes(x.edge.kind));q('#graph-node-meta').textContent=node?typeLabels[node.kind]+' · '+neighbors.length+' quan hệ đang lọc':'Chọn một nút để khám phá các quan hệ của nó.';
 for(const x of neighbors.slice(0,120)){const li=document.createElement('li');li.append(button(idx.nodes.get(x.id).title,()=>choose(x.id)),' · '+edgeLabels[x.edge.kind]+(x.edge.from===focus?' →':' ←'));near.append(li);}if(neighbors.length>120){const li=document.createElement('li');li.textContent='Còn '+(neighbors.length-120)+' quan hệ; dùng ô tìm kiếm để khám phá.';near.append(li);}
 const list=q('#graph-list');list.replaceChildren();for(const n of view.nodes){const li=document.createElement('li');li.append(button(n.title,()=>choose(n.id)),' · '+typeLabels[n.kind]);list.append(li);}
 q('#graph-back').disabled=!trail.length;refreshSearch();fit();}
 query.addEventListener('input',()=>graph&&refreshSearch());q('#graph-select').addEventListener('click',()=>{if(results.value)choose(results.value);});results.addEventListener('dblclick',()=>{if(results.value)choose(results.value);});results.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();if(results.value)choose(results.value);}});
 root.addEventListener('change',e=>{if(graph&&(e.target.matches('[data-kind],[data-edge]')||e.target.id==='graph-depth'))render();});
 q('#graph-back').addEventListener('click',()=>{if(trail.length){focus=trail.pop();render();}});q('#graph-overview').addEventListener('click',()=>choose(''));q('#graph-fit').addEventListener('click',fit);q('#graph-zoom-in').addEventListener('click',()=>zoom(.75));q('#graph-zoom-out').addEventListener('click',()=>zoom(1.333));
 svg.addEventListener('pointerdown',e=>{if(e.button!==0||e.target.closest('.graph-node'))return;drag={id:e.pointerId,x:e.clientX,y:e.clientY,cx:camera.x,cy:camera.y};ignoreClick=false;svg.setPointerCapture(e.pointerId);});
 svg.addEventListener('pointermove',e=>{if(!drag||drag.id!==e.pointerId)return;const dx=e.clientX-drag.x,dy=e.clientY-drag.y;if(Math.hypot(dx,dy)>4)ignoreClick=true;const scale=Math.min(svg.clientWidth/camera.w,svg.clientHeight/camera.h)||1;camera.x=drag.cx-dx/scale;camera.y=drag.cy-dy/scale;cameraDraw();});
 for(const name of ['pointerup','pointercancel','lostpointercapture'])svg.addEventListener(name,()=>{drag=null;setTimeout(()=>ignoreClick=false,0);});
 async function refresh(){const n=++seq;let notes=[];try{notes=await listNotes();noteWarning='';}catch{noteWarning='Không đọc được ghi chú cục bộ';}if(n!==seq)return;graph=assembleGraph(base,notes);if(!focus){const wanted=new URLSearchParams(location.search).get('focus');if(wanted&&graph.nodes.some(x=>x.id===wanted)&&!trail.length)focus=wanted;}render();}
 fetch('/graph-data.json').then(r=>{if(!r.ok)throw Error();return r.json();}).then(async data=>{base=data;await refresh();subscribe(refresh);window.addEventListener('pageshow',refresh);}).catch(()=>status.textContent='Không tải được dữ liệu đồ thị. Hãy tải lại trang.');q('#graph-controls').hidden=false;
}
</script>
